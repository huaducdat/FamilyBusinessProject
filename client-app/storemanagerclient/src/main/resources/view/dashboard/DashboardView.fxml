
<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane

        xmlns="http://javafx.com/javafx"

        xmlns:fx="http://javafx.com/fxml"

        fx:controller="
        com.huaducdat.storemanagerclient.controller.DashboardController
        "

        prefWidth="1280"

        prefHeight="800"

        style="
            -fx-background-color: #f5f5f7;
        ">

    <!-- ========================= -->
    <!-- TOP -->
    <!-- ========================= -->

    <top>

        <HBox

                alignment="CENTER_LEFT"

                spacing="16"

                style="
                    -fx-background-color: white;
                    -fx-padding: 16;
                    -fx-border-color: #e5e5e5;
                    -fx-border-width: 0 0 1 0;
                ">

            <Label

                    text="Store Manager Dashboard"

                    style="
                        -fx-font-size: 22;
                        -fx-font-weight: bold;
                    "/>

        </HBox>

    </top>

    <!-- ========================= -->
    <!-- LEFT -->
    <!-- ========================= -->

    <left>

        <VBox

                spacing="8"

                prefWidth="220"

                style="
                    -fx-background-color: white;
                    -fx-padding: 16;
                    -fx-border-color: #e5e5e5;
                    -fx-border-width: 0 1 0 0;
                ">

            <Button text="Dashboard"/>

            <Button text="Products"/>

            <Button text="Sales"/>

            <Button text="Customers"/>

            <Button text="Reports"/>

        </VBox>

    </left>

    <!-- ========================= -->
    <!-- CENTER -->
    <!-- ========================= -->

    <center>

        <StackPane

                fx:id="contentPane"

                style="
                    -fx-padding: 24;
                ">

            <Label

                    text="Dashboard Content"

                    style="
                        -fx-font-size: 24;
                        -fx-text-fill: #707070;
                    "/>

        </StackPane>

    </center>

</BorderPane>