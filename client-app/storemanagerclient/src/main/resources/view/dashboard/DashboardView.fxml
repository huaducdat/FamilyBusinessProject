<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.media.MediaView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane fx:id="rootStack"
           xmlns="http://javafx.com/javafx"
           xmlns:fx="http://javafx.com/fxml"
           fx:controller="com.huaducdat.storemanagerclient.dashboard.view.DashboardController"
           prefWidth="1280"
           prefHeight="800"
           styleClass="app-background">

    <StackPane fx:id="backgroundLayer"
               mouseTransparent="true"
               styleClass="background-layer">

        <ImageView fx:id="backgroundImageView"
                   mouseTransparent="true"
                   pickOnBounds="true"
                   preserveRatio="false"/>

        <MediaView fx:id="backgroundVideoView"
                   mouseTransparent="true"
                   preserveRatio="true"/>

        <Region mouseTransparent="true"
                styleClass="atmosphere-overlay"/>

    </StackPane>

    <StackPane fx:id="foregroundLayer"
               styleClass="foreground-layer">

        <BorderPane fx:id="dashboardRoot"
                    styleClass="glass-foreground dashboard-shell">

        <top>
            <StackPane fx:id="topbarPanel"
                       styleClass="dashboard-topbar">
                <HBox alignment="CENTER_LEFT"
                      spacing="32"
                      styleClass="dashboard-topbar-content">

                    <VBox spacing="4"
                          fillWidth="false">
                        <Label text="Store Manager Dashboard"
                               styleClass="title-lg text-primary"/>
                        <Label text="Cold structure, warm action"
                               styleClass="subtitle text-secondary"/>
                    </VBox>

                    <Label text="Live"
                           styleClass="signal-warm"/>

                    <Region HBox.hgrow="ALWAYS"/>

                    <HBox spacing="12"
                          alignment="CENTER"
                          fx:id="modeCapsule"
                          styleClass="mode-capsule">

                        <StackPane fx:id="videoModePill"
                                   styleClass="mode-pill">
                            <Label text="Video"
                                   styleClass="mode-pill-label"/>
                        </StackPane>

                        <StackPane fx:id="imageModePill"
                                   styleClass="mode-pill">
                            <Label text="Image"
                                   styleClass="mode-pill-label"/>
                        </StackPane>

                    </HBox>

                    <Button text="Logout"
                            onAction="#onLogout"
                            styleClass="glass-button secondary-button"/>

                </HBox>
            </StackPane>
            <BorderPane.margin>
                <Insets top="32" right="32" bottom="16" left="32"/>
            </BorderPane.margin>
        </top>

        <left>
            <StackPane fx:id="sidebarPanel"
                       styleClass="dashboard-sidebar">
                <VBox spacing="16"
                      prefWidth="292"
                      styleClass="dashboard-sidebar-content">

                    <Label text="Navigation"
                           styleClass="subtitle text-secondary"/>

                    <Button text="Dashboard"
                            styleClass="glass-button glass-button-active"/>
                    <Button text="Products"
                            styleClass="glass-button"/>
                    <Button text="Sales"
                            styleClass="glass-button"/>
                    <Button text="Customers"
                            styleClass="glass-button"/>
                    <Button text="Reports"
                            styleClass="glass-button"/>

                </VBox>
            </StackPane>
            <BorderPane.margin>
                <Insets top="0" right="16" bottom="32" left="32"/>
            </BorderPane.margin>
        </left>

        <center>
            <StackPane fx:id="contentPanel"
                       styleClass="dashboard-content">
                <StackPane fx:id="contentPane"
                           styleClass="dashboard-content-content">

                    <VBox spacing="20"
                          maxWidth="520">

                        <Label text="Command center"
                               styleClass="title-md text-primary"/>
                        <Label text="This layout is intentionally calm: cold surfaces, precise spacing, and warm accents reserved for action states and critical data."
                               wrapText="true"
                               styleClass="subtitle text-secondary"/>
                        <Label text="Dashboard content placeholder"
                               styleClass="signal-warm"/>

                    </VBox>

                </StackPane>
            </StackPane>
            <BorderPane.margin>
                <Insets top="0" right="32" bottom="32" left="16"/>
            </BorderPane.margin>
        </center>

        </BorderPane>

    </StackPane>

</StackPane>
