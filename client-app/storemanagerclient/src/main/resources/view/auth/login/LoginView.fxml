<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.media.MediaView?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane fx:id="rootStack"
           xmlns="http://javafx.com/javafx"
           xmlns:fx="http://javafx.com/fxml"
           fx:controller="com.huaducdat.storemanagerclient.auth.view.LoginController"
           prefWidth="520"
           prefHeight="720"
           styleClass="app-background">

    <StackPane fx:id="backgroundLayer"
               mouseTransparent="true"
               styleClass="background-layer">

        <ImageView fx:id="backgroundImageView"
                   mouseTransparent="true"
                   pickOnBounds="true"
                   preserveRatio="false"/>

        <MediaView fx:id="backgroundVideoView"
                   mouseTransparent="true"
                   preserveRatio="true"/>

        <Region mouseTransparent="true"
                styleClass="atmosphere-overlay"/>

    </StackPane>

    <StackPane fx:id="foregroundLayer"
               styleClass="foreground-layer">

        <VBox alignment="CENTER_LEFT"
              spacing="28"
              fillWidth="true"
              maxWidth="440"
              styleClass="glass-card login-shell">

            <VBox spacing="12"
                  fillWidth="false"
                  styleClass="login-hero">

                <Label text="Secure access"
                       styleClass="signal-warm"/>

                <Label text="Store Manager"
                       styleClass="login-title"/>

                <Label text="Retail Management System"
                       styleClass="login-subtitle"/>

                <HBox spacing="12"
                      alignment="CENTER"
                      fx:id="modeCapsule"
                      styleClass="mode-capsule">

                    <StackPane fx:id="videoModePill"
                               styleClass="mode-pill">
                        <Label text="Video"
                               styleClass="mode-pill-label"/>
                    </StackPane>

                    <StackPane fx:id="imageModePill"
                               styleClass="mode-pill">
                        <Label text="Image"
                               styleClass="mode-pill-label"/>
                    </StackPane>

                </HBox>

            </VBox>

            <VBox spacing="20"
                  fillWidth="true"
                  styleClass="login-form">

                <TextField fx:id="usernameField"
                           promptText="Username"
                           maxWidth="Infinity"
                           styleClass="field"/>

                <TextField fx:id="passwordField"
                           promptText="Password"
                           maxWidth="Infinity"
                           styleClass="field"/>

                <Button fx:id="loginButton"
                        text="Login"
                        maxWidth="Infinity"
                        onAction="#onLogin"
                        styleClass="glass-button primary-button"/>

                <ProgressIndicator fx:id="loadingIndicator"
                                   visible="false"
                                   managed="false"
                                   prefWidth="28"
                                   prefHeight="28"
                                   styleClass="progress-ring"/>

                <Label fx:id="statusLabel"
                       wrapText="true"
                       styleClass="login-status"/>

            </VBox>

        </VBox>

    </StackPane>

</StackPane>
