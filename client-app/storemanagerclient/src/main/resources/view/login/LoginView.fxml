<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<StackPane

        xmlns="http://javafx.com/javafx"

        xmlns:fx="http://javafx.com/fxml"

        fx:controller="com.huaducdat.storemanagerclient.controller.LoginController"

        prefWidth="520"

        prefHeight="720"

        style="
            -fx-background-color:
                linear-gradient(
                    to bottom right,
                    #ffe0d2 0%,
                    #f5f5f7 35%,
                    #d7ecff 100%
                );
        ">

    <!-- ========================= -->
    <!-- CARD -->
    <!-- ========================= -->

    <VBox

            alignment="CENTER"

            spacing="18"

            maxWidth="360"

            style="
                -fx-background-color:
                    rgba(255,255,255,0.78);

                -fx-background-radius: 24;

                -fx-padding: 36;

                -fx-border-radius: 24;

                -fx-border-color:
                    rgba(255,255,255,0.9);

                -fx-effect:
                    dropshadow(
                        gaussian,
                        rgba(0,0,0,0.08),
                        30,
                        0.2,
                        0,
                        10
                    );
            ">

        <!-- ========================= -->
        <!-- TITLE -->
        <!-- ========================= -->

        <Label

                text="Store Manager"

                style="
                    -fx-font-size: 30;
                    -fx-font-weight: bold;
                    -fx-text-fill: #202020;
                "/>

        <!-- ========================= -->
        <!-- SUBTITLE -->
        <!-- ========================= -->

        <Label

                text="Retail Management System"

                style="
                    -fx-font-size: 13;
                    -fx-text-fill: #707070;
                "/>

        <!-- ========================= -->
        <!-- USERNAME -->
        <!-- ========================= -->

        <TextField

                fx:id="usernameField"

                promptText="Username"

                maxWidth="Infinity"

                style="
                    -fx-background-radius: 14;
                    -fx-padding: 12;
                    -fx-font-size: 14;
                    -fx-background-color: white;
                    -fx-border-color: #d8d8d8;
                    -fx-border-radius: 14;
                "/>

        <!-- ========================= -->
        <!-- PASSWORD -->
        <!-- ========================= -->

        <PasswordField

                fx:id="passwordField"

                promptText="Password"

                maxWidth="Infinity"

                style="
                    -fx-background-radius: 14;
                    -fx-padding: 12;
                    -fx-font-size: 14;
                    -fx-background-color: white;
                    -fx-border-color: #d8d8d8;
                    -fx-border-radius: 14;
                "/>

        <!-- ========================= -->
        <!-- BUTTON -->
        <!-- ========================= -->

        <Button

                text="Login"

                maxWidth="Infinity"

                onAction="#onLogin"

                style="
                    -fx-background-color:
                        linear-gradient(
                            to right,
                            #ff9a7b,
                            #6db8ff
                        );

                    -fx-text-fill: white;

                    -fx-font-size: 14;

                    -fx-font-weight: bold;

                    -fx-padding: 14;

                    -fx-background-radius: 16;

                    -fx-cursor: hand;
                "/>

        <!-- ========================= -->
        <!-- STATUS -->
        <!-- ========================= -->

        <Label

                fx:id="statusLabel"

                style="
                    -fx-font-size: 13;
                    -fx-text-fill: #ff4d4d;
                "/>

    </VBox>

</StackPane>